<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Fontager.Viewer</RootNamespace>
    <!-- Output binary name + Explorer "Details" pane (Product / Company). -->
    <AssemblyName>Fontager Viewer</AssemblyName>
    <AssemblyTitle>Fontager Viewer</AssemblyTitle>
    <Product>Fontager Viewer</Product>
    <Company>Fontager</Company>
    <AssemblyDescription>Font preview and install helper for Windows.</AssemblyDescription>
    <!-- WinUI cannot run as a true single-file bundle; VS publish sometimes enables it. -->
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Logo.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <!-- CsWinRT: generic collections crossing ABI need unsafe stubs when trimming/AOT analyzers run. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Distribution: UNPACKAGED (no MSIX / Store identity).

      Rationale and tradeoffs:
        docs/research/packaging-decision.md

      What "unpackaged" buys us:
        * Real HKCU writes (Settings → Fonts shows "Uninstall", not just "Hide").
        * .ttf file association becomes possible for the current user.
        * Standard Win32 access (no AppContainer restrictions on registry/FS).
        * Smaller, simpler distribution (a single folder you can zip).

      WindowsAppSDKSelfContained=true bundles the Windows App SDK runtime into
      the output directory so end users do NOT need to install a runtime first.
      Cost is ~40-60 MB of extra binaries shipped alongside the EXE.

      Re-enabling MSIX / Store distribution later:
        1. Set WindowsPackageType back to MSIX (or remove the line).
        2. Set EnableMsixTooling to true (gates the MSIX-only properties below).
        3. Update Package.appxmanifest (kept in the repo for exactly this).
        See docs/research/packaging-decision.md for the full checklist.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- Assembly version is what Package.Current.Id.Version used to provide.
         Bump in lockstep with Package.appxmanifest's Version attribute so the
         in-app "About" version stays accurate regardless of distribution mode. -->
    <Version>1.2.2</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\Logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fontager.Core\Fontager.Core.csproj" />
  </ItemGroup>

  <!-- ===================================================================
       MSIX / Store distribution — gated, currently disabled
       Switch EnableMsixTooling=true above to reactivate everything below.
       Package.appxmanifest is intentionally kept in the repo so re-enable
       is a one-property change.
       =================================================================== -->
  <ItemGroup Condition="'$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug' and '$(SelfContained)' == 'true'">True</PublishTrimmed>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <AppInstallerUri>C:\Users\albayrak\Projeler\Fontager\Fontager.Viewer\bin\x64\Release\net8.0-windows10.0.19041.0\AppPackages</AppInstallerUri>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <PackageCertificateThumbprint>4C259B69DD051A1E7CDB4C613C58B5366D62A9E5</PackageCertificateThumbprint>
  </PropertyGroup>

  <!-- Unpackaged WinUI: publish omits compiled XAML (.xbf) and the app .pri (WindowsAppSDK #3451). -->
  <Target Name="CopyWinUIResourcesToPublishDirectory" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <PropertyGroup>
      <_WinUIPublishSource>$([MSBuild]::NormalizeDirectory('$(PublishDir)', '..'))</_WinUIPublishSource>
    </PropertyGroup>
    <ItemGroup>
      <_WinUIPublishResource Include="$(_WinUIPublishSource)**\*.xbf" />
      <_WinUIPublishResource Include="$(_WinUIPublishSource)*.pri" />
      <_WinUIPublishResource Include="$(_WinUIPublishSource)Assets\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WinUIPublishResource)"
      DestinationFiles="@(_WinUIPublishResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="Exists('$(PublishDir)') and '@(_WinUIPublishResource)' != ''" />
  </Target>
</Project>
