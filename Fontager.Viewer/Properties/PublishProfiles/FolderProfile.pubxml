<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <!-- Must match WinUI / WASDK native payloads (never AnyCPU for this app). -->
    <Platform>x64</Platform>
    <!-- Default VS template used bin\Release\Publish — outside the SDK layout and often
         missing or mismatched runtime files vs a normal Build output. Use the same tree
         as `dotnet publish -r win-x64` so the folder is always complete and self-contained. -->
    <PublishDir>bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>