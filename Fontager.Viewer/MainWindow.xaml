<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fontager.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fontager.Viewer"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converters="using:Fontager.Viewer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fontager Viewer">

    <!-- SystemBackdrop is applied from code (ApplyBackdrop) so we don't recreate it on every settings save. -->

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
            <converters:FontWeightToStringConverter x:Key="FontWeightToString" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom drag caption (SetTitleBar): caption-button insets + compact layout.
             Interactive regions are registered as passthrough via code-behind so clicks
             hit buttons instead of starting a drag loop — updates are coalesced per frame.
             Back uses Fluent AnimatedBackVisualSource with explicit PointerOver/Normal states.
             Font name lives in the main header only; taskbar/title still uses AppWindow.Title. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" VerticalAlignment="Top" Padding="6,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Spacing="0">
                    <Button x:Name="BackButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0"
                            Padding="8,5"
                            MinHeight="36"
                            MinWidth="40"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Back"
                            Click="CustomTitleBarBack_Click"
                            PointerEntered="BackButton_PointerEntered"
                            PointerExited="BackButton_PointerExited">
                        <AnimatedIcon x:Name="BackAnimatedIcon" Width="16" Height="16">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedBackVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Back" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="12,0,14,0">
                        <Image Source="Assets/Logo.png"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Fontager Viewer"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TitleBarVersion"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <StackPanel x:Name="OpenButtonPanel" Orientation="Horizontal" Spacing="2">
                            <Button x:Name="OpenFileButton"
                                    Click="OpenFileButton_Click"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Open font file (Ctrl+O)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Open" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button x:Name="SettingsButton"
                                Click="SettingsButton_Click"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                        </Button>
                        <Button x:Name="UpdateNotificationButton"
                                Visibility="Collapsed"
                                Click="UpdateNotificationButton_Click"
                                VerticalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="A new version of Fontager is available!">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="Update Available" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
