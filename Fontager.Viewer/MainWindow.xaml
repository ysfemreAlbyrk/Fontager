<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fontager.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fontager.Viewer"
    xmlns:converters="using:Fontager.Viewer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fontager Viewer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
            <converters:FontWeightToStringConverter x:Key="FontWeightToString" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="188" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D2;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Fontager Viewer" Style="{StaticResource CaptionTextBlockStyle}" 
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="16,0,0,0">
                <Button x:Name="OpenFileButton" 
                        Click="OpenFileButton_Click"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Open font file (Ctrl+O)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Open" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button x:Name="SettingsButton" Grid.Column="2"
                    Click="SettingsButton_Click"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <TextBlock x:Name="TitleBarFontName" Grid.Column="3" 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Opacity="0.6" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">

            <!-- Empty State -->
            <Grid x:Name="EmptyState" Visibility="Visible"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="400">
                    <FontIcon Glyph="&#xE8D2;" FontSize="64" 
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Fontager Viewer" 
                               Style="{StaticResource TitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Open a font file to preview it, or drag and drop a .ttf, .otf, .ttc, or .woff2 file here."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <Button Content="Open Font File" 
                            Click="OpenFileButton_Click"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="24,10" />
                </StackPanel>
            </Grid>

            <!-- Loading State -->
            <Grid x:Name="LoadingState" Visibility="Collapsed"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="48" Height="48" />
                    <TextBlock Text="Loading font..." 
                               Style="{StaticResource BodyTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Error State -->
            <Grid x:Name="ErrorState" Visibility="Collapsed"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="400">
                    <FontIcon Glyph="&#xE783;" FontSize="48" 
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" 
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <Button Content="Try Another File" 
                            Click="OpenFileButton_Click"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- Font Content -->
            <Grid x:Name="FontContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Font Header -->
                <Grid Grid.Row="0" Padding="24,16,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="FontFamilyName" 
                                       Style="{StaticResource TitleTextBlockStyle}" />
                            <!-- Install button in header -->
                            <Button x:Name="InstallButton"
                                    Click="InstallButton_Click"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="12,6"
                                    ToolTipService.ToolTip="Install font for current user">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Install" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="FontStyleName" 
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border x:Name="FormatBadge" 
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="8,2">
                                <TextBlock x:Name="FormatBadgeText" 
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <Border x:Name="VariableBadge" Visibility="Collapsed"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="4" Padding="8,2">
                                <TextBlock Text="Variable" 
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="8" VerticalAlignment="Center">
                        <!-- Multi-font navigation -->
                        <StackPanel x:Name="FontNavPanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                            <TextBlock x:Name="FontIndexLabel" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="PrevFontButton" Click="PrevFontButton_Click"
                                    ToolTipService.ToolTip="Previous font in collection"
                                    IsEnabled="False" Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                    <TextBlock VerticalAlignment="Center">Prev</TextBlock>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NextFontButton" Click="NextFontButton_Click"
                                    ToolTipService.ToolTip="Next font in collection"
                                    Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock VerticalAlignment="Center">Next</TextBlock>
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="FontFileSize" 
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <!-- Tabs -->
                <Pivot x:Name="ContentPivot" Grid.Row="1" Margin="12,4,0,0">

                    <!-- Preview Tab -->
                    <PivotItem Header="Preview">
                        <ScrollViewer Padding="-12,16,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <!-- Unified preview: editable text rendered in the font -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <Slider x:Name="FontSizeSlider" 
                                                Minimum="8" Maximum="120" Value="32"
                                                Width="160"
                                                ValueChanged="FontSizeSlider_ValueChanged"
                                                ToolTipService.ToolTip="Font size" />
                                        <TextBlock x:Name="FontSizeLabel" Text="32px" 
                                                   VerticalAlignment="Center" Width="40"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Single editable preview area: TextBox styled as the font -->
                                <TextBox x:Name="PreviewTextBox"
                                         PlaceholderText="Type preview text here..."
                                         Text="The quick brown fox jumps over the lazy dog. 0123456789"
                                         TextChanged="PreviewTextBox_TextChanged"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontSize="32"
                                         MinHeight="80"
                                         Padding="16"
                                         BorderThickness="1"
                                         CornerRadius="8" />

                                <!-- Waterfall (inside Preview, togglable) -->
                                <StackPanel x:Name="WaterfallSection" Spacing="1">
                                    <StackPanel x:Name="WaterfallPanel" Spacing="1" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <!-- Glyphs Tab -->
                    <PivotItem Header="Glyphs">
                        <ScrollViewer Padding="12,16" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                    <Run x:Name="GlyphCountText" Text="0" />
                                    <Run Text=" glyphs in font" />
                                </TextBlock>
                                <GridView x:Name="GlyphGrid"
                                          SelectionMode="Single"
                                          SelectionChanged="GlyphGrid_SelectionChanged"
                                          IsItemClickEnabled="True">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" 
                                                           ItemWidth="72" ItemHeight="88"
                                                           MaximumRowsOrColumns="20" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" Spacing="2" Padding="4">
                                                <TextBlock Text="{Binding Character}" 
                                                           FontSize="28" 
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center" />
                                                <TextBlock Text="{Binding UnicodeLabel}" 
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="10" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <Border x:Name="GlyphDetailPanel" Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="24" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedGlyphChar" 
                                                   FontSize="72" VerticalAlignment="Center"
                                                   Margin="0,0,24,0" />
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="SelectedGlyphUnicode" 
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="SelectedGlyphName" 
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <!-- Metadata Tab -->
                    <PivotItem Header="Info">
                        <ScrollViewer Padding="12,16" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4" x:Name="MetadataPanel" />
                        </ScrollViewer>
                    </PivotItem>

                </Pivot>
            </Grid>
        </Grid>
    </Grid>
</Window>
