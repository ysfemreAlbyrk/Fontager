<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fontager.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fontager.Viewer"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converters="using:Fontager.Viewer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fontager Viewer">

    <!-- SystemBackdrop is applied from code (ApplyBackdrop) so we don't recreate it on every settings save. -->

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
            <converters:FontWeightToStringConverter x:Key="FontWeightToString" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom drag caption (SetTitleBar): caption-button insets + compact layout.
             Interactive regions are registered as passthrough via code-behind so clicks
             hit buttons instead of starting a drag loop — updates are coalesced per frame.
             Back uses Fluent AnimatedBackVisualSource with explicit PointerOver/Normal states.
             Font name lives in the main header only; taskbar/title still uses AppWindow.Title. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" VerticalAlignment="Top" Padding="6,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Spacing="0">
                    <Button x:Name="BackButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0"
                            Padding="8,5"
                            MinHeight="36"
                            MinWidth="40"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Back"
                            Click="CustomTitleBarBack_Click"
                            PointerEntered="BackButton_PointerEntered"
                            PointerExited="BackButton_PointerExited">
                        <AnimatedIcon x:Name="BackAnimatedIcon" Width="16" Height="16">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedBackVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Back" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="12,0,14,0">
                        <Image Source="Assets/Logo.png"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Fontager Viewer"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TitleBarVersion"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <StackPanel x:Name="OpenButtonPanel" Orientation="Horizontal" Spacing="2">
                            <Button x:Name="OpenFileButton"
                                    Click="OpenFileButton_Click"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Open font file (Ctrl+O)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Open" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button x:Name="SettingsButton"
                                Click="SettingsButton_Click"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                        </Button>
                        <Button x:Name="UpdateNotificationButton"
                                Visibility="Collapsed"
                                Click="UpdateNotificationButton_Click"
                                VerticalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="A new version of Fontager is available!">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="Update Available" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area
             MainContentArea hosts the viewer (empty / loading / error / content
             states). When the user opens Settings we collapse MainContentArea
             and reveal SettingsFrame, which navigates to SettingsPage. The
             back button in the title bar reverses this. -->
        <Grid Grid.Row="1">
            <Grid x:Name="MainContentArea" Visibility="Visible">

            <!-- Empty State -->
            <Grid x:Name="EmptyState" Visibility="Visible"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20" HorizontalAlignment="Center" MaxWidth="420">
                    <Image Source="Assets/Logo.png" Width="64" Height="64" 
                           HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateTitle" Text="Fontager Viewer" 
                               Style="{StaticResource TitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Open a font file to preview it, or drag and drop a .ttf, .otf, .ttc, or .woff2 file here."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <Button Content="Open Font File" 
                            Click="OpenFileButton_Click"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="24,10" />
                    <StackPanel Spacing="6" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyStateVersion" 
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Made by Yusuf Emre Albayrak"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <HyperlinkButton x:Name="EmptyStateGitHub" Content="GitHub"
                                             Click="EmptyStateGitHub_Click"
                                             Padding="0" />
                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="EmptyStateWebsite" Content="Website"
                                             Click="EmptyStateWebsite_Click"
                                             Padding="0" />
                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="EmptyStateChangelog" Content="Changelog"
                                             Click="EmptyStateChangelog_Click"
                                             Padding="0" />
                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="EmptyStateRoadmap" Content="Roadmap"
                                             Click="EmptyStateRoadmap_Click"
                                             Padding="0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Loading State -->
            <Grid x:Name="LoadingState" Visibility="Collapsed"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="48" Height="48" />
                    <TextBlock Text="Loading font..." 
                               Style="{StaticResource BodyTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Error State -->
            <Grid x:Name="ErrorState" Visibility="Collapsed"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="400">
                    <FontIcon Glyph="&#xE783;" FontSize="48" 
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" 
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <Button Content="Try Another File" 
                            Click="OpenFileButton_Click"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- Font Content -->
            <Grid x:Name="FontContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ═══ Font Header ═══ -->
                <Grid Grid.Row="0" Padding="24,12,24,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top row: Name + nav + install -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="FontFamilyName" Grid.Column="0"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Right: nav + install -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                            <StackPanel x:Name="FontNavPanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                <Button x:Name="PrevFontButton" Click="PrevFontButton_Click"
                                        ToolTipService.ToolTip="Previous font"
                                        IsEnabled="False" Padding="8,8"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon Glyph="&#xE76B;" FontSize="11" />
                                </Button>
                                <TextBlock x:Name="FontIndexLabel" 
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="2,0,2,2"/>
                                <Button x:Name="NextFontButton" Click="NextFontButton_Click"
                                        ToolTipService.ToolTip="Next font"
                                        Padding="8,8"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                </Button>
                            </StackPanel>

                            <SplitButton x:Name="InstallSplitButton"
                                         Click="InstallSplitButton_Click"
                                         Padding="12,8"
                                         IsEnabled="False">
                                <SplitButton.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE896;" FontSize="13" />
                                        <TextBlock x:Name="InstallButtonText"
                                                   Text="Install"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </SplitButton.Content>
                                <SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="InstallCurrentUserMenuFlyoutItem"
                                                        Text="Install for current user"
                                                        Click="InstallCurrentUserMenuItem_Click" />
                                        <MenuFlyoutItem x:Name="InstallAllUsersMenuFlyoutItem"
                                                        Text="Install for all users (requires admin)"
                                                        Click="InstallAllUsersMenuItem_Click" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <TextBlock x:Name="InstallNotSupportedMessage"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center"
                                       MaxWidth="280"
                                       TextWrapping="WrapWholeWords"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Installation isn&apos;t supported for WOFF2. Windows expects TrueType (.ttf), OpenType (.otf), or a collection (.ttc). Convert the file to install it." />
                        </StackPanel>
                    </Grid>

                    <!-- Bottom row: metadata chips -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                        <TextBlock x:Name="FontStyleName" 
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border x:Name="FormatBadge" 
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock x:Name="FormatBadgeText" FontSize="11"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <Border x:Name="VariableBadge" Visibility="Collapsed"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="Variable" FontSize="11"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <TextBlock x:Name="FontFileSize" 
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ═══ Quick View ═══ -->
                <Border x:Name="QuickViewSection" Grid.Row="1" 
                        Margin="20,10,20,4" Padding="16,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel x:Name="QuickViewPanel" Spacing="2" />
                </Border>

                <!-- ═══ Tabs ═══ -->
                <Pivot x:Name="ContentPivot" Grid.Row="2" Margin="12,0,0,0">
                    <Pivot.Resources>
                        <Style TargetType="PivotHeaderItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Height" Value="32" />
                        </Style>
                    </Pivot.Resources>
                    <!-- Framework-provided content transition only (no custom storyboards). -->
                    <Pivot.ItemContainerTransitions>
                        <TransitionCollection>
                            <ContentThemeTransition />
                        </TransitionCollection>
                    </Pivot.ItemContainerTransitions>

                    <!-- Preview Tab -->
                    <PivotItem Header="Preview">
                        <Border x:Name="PreviewSurfaceBorder" Background="Transparent">
                        <ScrollViewer Padding="-12,8,12,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
 
                                <!-- Editable preview + size control -->
                                <Grid x:Name="PreviewSection" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
 
                                    <TextBox x:Name="PreviewTextBox" Grid.Column="0"
                                             PlaceholderText="Type preview text here..."
                                             Text="The quick brown fox jumps over the lazy dog. 0123456789"
                                             TextChanged="PreviewTextBox_TextChanged"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontSize="32"
                                             MinHeight="56"
                                             Padding="12"
                                             BorderThickness="0"
                                             CornerRadius="8" />
 
                                    <!-- Size control on the right -->
                                    <StackPanel Grid.Column="1" Spacing="2"
                                                VerticalAlignment="Center">
                                        <Button x:Name="FontSizeUpButton"
                                                Click="FontSizeUpButton_Click"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Padding="6,4" MinWidth="0" MinHeight="0"
                                                ToolTipService.ToolTip="Increase font size">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        </Button>
                                        <TextBlock x:Name="FontSizeLabel"
                                                   Text="32" 
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button x:Name="FontSizeDownButton"
                                                Click="FontSizeDownButton_Click"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Padding="6,4" MinWidth="0" MinHeight="0"
                                                ToolTipService.ToolTip="Decrease font size">
                                            <FontIcon Glyph="&#xE738;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
 
                                <!-- Waterfall -->
                                <StackPanel x:Name="WaterfallSection" Spacing="0" Margin="0" Padding="0,0,0,0">
                                    <!--<TextBlock Text="Waterfall" 
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Margin="0,0,0,6"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />-->
                                    <StackPanel x:Name="WaterfallPanel" Spacing="0" Margin="0"
                                                Padding="0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        </Border>
                    </PivotItem>

                    <!-- Glyphs Tab -->
                    <PivotItem Header="Glyphs">
                        <Border Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar: search + category chips -->
                            <Grid Grid.Row="0" Padding="12,8,12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <AutoSuggestBox x:Name="GlyphSearchBox" Grid.Column="0"
                                                PlaceholderText="Search character or code point (e.g. A, U+00A0, 9731)"
                                                QueryIcon="Find"
                                                TextChanged="GlyphSearchBox_TextChanged" />

                                <StackPanel x:Name="GlyphCategoryChips" Grid.Column="1"
                                            Orientation="Horizontal" Spacing="4" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Sidebar: Unicode blocks covered by the font -->
                                <ListView x:Name="GlyphBlockList" Grid.Column="0"
                                          Margin="6,0,6,8"
                                          SelectionMode="Single"
                                          SelectionChanged="GlyphBlockList_SelectionChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="MinHeight" Value="34" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Glyph grid + details
                                     IMPORTANT: do NOT wrap the GridView in a ScrollViewer
                                     here. The GridView ships with its own ItemsWrapGrid
                                     virtualizing panel and only virtualizes when it gets
                                     a bounded height. Nesting it inside ScrollViewer >
                                     StackPanel hands it infinite height and forces every
                                     item to materialize up-front — that was the root
                                     cause of the Glyphs-tab freeze on CJK / emoji fonts
                                     with 10k+ glyphs. -->
                                <Grid Grid.Column="1" Padding="12,0,12,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Margin="0,0,0,8"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run x:Name="GlyphCountText" Text="0" />
                                        <Run Text=" glyphs shown" />
                                    </TextBlock>

                                    <GridView Grid.Row="1" x:Name="GlyphGrid"
                                              SelectionMode="Single"
                                              SelectionChanged="GlyphGrid_SelectionChanged"
                                              IsItemClickEnabled="True"
                                              ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollMode="Enabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.IsVerticalScrollChainingEnabled="False">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- Orientation="Horizontal" with vertical scrolling makes
                                                     the wrap grid lay out rows top-to-bottom, exactly what
                                                     virtualization expects so off-screen rows stay
                                                     unrealized. -->
                                                <ItemsWrapGrid Orientation="Horizontal"
                                                               ItemWidth="72" ItemHeight="88"
                                                               CacheLength="2" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="72" Height="88" Padding="2"
                                                      Background="Transparent">
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding Character}"
                                                                   FontSize="28"
                                                                   HorizontalAlignment="Center"
                                                                   TextAlignment="Center" />
                                                        <TextBlock Text="{Binding UnicodeLabel}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                    <Border Grid.Row="2" x:Name="GlyphDetailPanel" Visibility="Collapsed"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="24" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-8,-8,-8"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="Close"
                                                    AutomationProperties.Name="Close glyph details"
                                                    Click="GlyphDetailClose_Click">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                            </Button>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SelectedGlyphChar"
                                                           Grid.Column="0"
                                                           FontSize="72"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,24,0" />
                                                <StackPanel Grid.Column="1"
                                                            Spacing="10"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,16,0">
                                                    <TextBlock x:Name="SelectedGlyphUnicode"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock x:Name="SelectedGlyphName"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            Spacing="6">
                                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                                            HorizontalAlignment="Right"
                                                            Click="GlyphDetailCopy_Click"
                                                            ToolTipService.ToolTip="Copy character to clipboard">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                            <TextBlock Text="Copy character"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock x:Name="GlyphDetailCopiedNotice"
                                                               Text="Copied"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                               HorizontalAlignment="Right"
                                                               Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                        </Border>
                    </PivotItem>

                    <!-- Metadata Tab -->
                    <PivotItem Header="Info">
                        <Border Background="Transparent">
                        <ScrollViewer Padding="12,8" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4" x:Name="MetadataPanel" />
                        </ScrollViewer>
                        </Border>
                    </PivotItem>

                </Pivot>
            </Grid>
            </Grid>

            <!-- Settings overlay
                 Hidden by default. Settings opens via SettingsButton_Click:
                 SettingsFrame navigates to SettingsPage on the next dispatcher
                 tick after the frame becomes visible. CustomTitleBarBack_Click
                 closes the overlay (Fluent AnimatedBackVisualSource back affordance). -->
            <Frame x:Name="SettingsFrame" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
