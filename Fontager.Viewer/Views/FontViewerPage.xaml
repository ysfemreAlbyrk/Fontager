<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fontager.Viewer.Views.FontViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fontager.Viewer.Views"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converters="using:Fontager.Viewer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
        <converters:FontWeightToStringConverter x:Key="FontWeightToString" />

        <Style x:Key="MetadataCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </Page.Resources>

    <Grid x:Name="MainContentArea" Visibility="Visible">

        <!-- Empty State -->
        <Grid x:Name="EmptyState" Visibility="{x:Bind ViewModel.HasFont, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="20" HorizontalAlignment="Center" MaxWidth="480">
                <Image Source="ms-appx:///Assets/Logo.png" Width="64" Height="64" 
                       HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateTitle" Text="Fontager Viewer" 
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Open a font file to preview it, or drag and drop a .ttf, .otf, .ttc, or .woff2 file here."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="WrapWholeWords" />
                <Button Content="Open Font File" 
                        Click="OpenFileButton_Click"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="24,10" />

                <StackPanel Spacing="8"
                            Margin="0,4,0,0"
                            Visibility="{x:Bind ViewModel.HasRecentFiles, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Stretch">
                    <TextBlock Text="Recent"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Left" />
                    <ListView x:Name="RecentFilesList"
                               ItemsSource="{x:Bind ViewModel.RecentFiles, Mode=OneWay}"
                               SelectionMode="None"
                               IsItemClickEnabled="True"
                               MaxHeight="220"
                               HorizontalAlignment="Stretch"
                               ItemClick="RecentFilesList_ItemClick">
                        <ListView.Resources>
                            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:RecentFileItem"
                                          xmlns:viewModels="using:Fontager.Viewer.ViewModels">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8E5;"
                                              FontSize="16"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FileName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DirectoryLabel}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Path}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="6"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Remove from recent"
                                            Click="RecentFileRemove_Click">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Spacing="6" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyStateVersion" 
                               Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Made by Yusuf Emre Albayrak"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <HyperlinkButton x:Name="EmptyStateGitHub" Content="GitHub"
                                         Click="EmptyStateGitHub_Click"
                                         Padding="0" />
                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="EmptyStateWebsite" Content="Website"
                                         Click="EmptyStateWebsite_Click"
                                         Padding="0" />
                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="EmptyStateChangelog" Content="Changelog"
                                         Click="EmptyStateChangelog_Click"
                                         Padding="0" />
                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="EmptyStateRoadmap" Content="Roadmap"
                                         Click="EmptyStateRoadmap_Click"
                                         Padding="0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Loading State -->
        <Grid x:Name="LoadingState" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="Loading font..." 
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Error State -->
        <Grid x:Name="ErrorState" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="400">
                <FontIcon Glyph="&#xE783;" FontSize="48" 
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText" 
                           Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="WrapWholeWords" />
                <Button Content="Try Another File" 
                        Click="OpenFileButton_Click"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Font Content -->
        <Grid x:Name="FontContent" Visibility="{x:Bind ViewModel.HasFont, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══ Font Header ═══ -->
            <Grid Grid.Row="0" Padding="24,12,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top row: Name + nav + install -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FontFamilyName" Grid.Column="0"
                               Text="{x:Bind ViewModel.HeaderDisplayName, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Right: nav + install -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                        <StackPanel x:Name="FontNavPanel" Orientation="Horizontal" Spacing="4" 
                                    Visibility="{x:Bind ViewModel.IsCollectionNavVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Button x:Name="PrevFontButton" Click="PrevFontButton_Click"
                                    ToolTipService.ToolTip="Previous font"
                                    IsEnabled="{x:Bind ViewModel.IsPrevFontEnabled, Mode=OneWay}" Padding="8,8"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE76B;" FontSize="11" />
                            </Button>
                            <TextBlock x:Name="FontIndexLabel" 
                                       Text="{x:Bind ViewModel.FontIndexLabelText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="2,0,2,2"/>
                            <Button x:Name="NextFontButton" Click="NextFontButton_Click"
                                    ToolTipService.ToolTip="Next font"
                                    IsEnabled="{x:Bind ViewModel.IsNextFontEnabled, Mode=OneWay}"
                                    Padding="8,8"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE76C;" FontSize="11" />
                            </Button>
                        </StackPanel>

                        <SplitButton x:Name="InstallSplitButton"
                                     Click="InstallSplitButton_Click"
                                     Padding="12,8"
                                     IsEnabled="{x:Bind ViewModel.IsInstallEnabled, Mode=OneWay}">
                            <SplitButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                                    <TextBlock x:Name="InstallButtonText"
                                               Text="Install"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="InstallCurrentUserMenuFlyoutItem"
                                                    Text="Install for current user"
                                                    Click="InstallCurrentUserMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="InstallAllUsersMenuFlyoutItem"
                                                    Text="Install for all users (requires admin)"
                                                    Click="InstallAllUsersMenuItem_Click" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <TextBlock x:Name="InstallNotSupportedMessage"
                                   Visibility="{x:Bind ViewModel.IsInstallNotSupportedVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   VerticalAlignment="Center"
                                   MaxWidth="280"
                                   TextWrapping="WrapWholeWords"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Installation isn&apos;t supported for WOFF2. Windows expects TrueType (.ttf), OpenType (.otf), or a collection (.ttc). Convert the file to install it." />
                    </StackPanel>
                </Grid>

                <!-- Bottom row: metadata chips -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FontStyleName" 
                               Text="{x:Bind ViewModel.HeaderSubfamilyName, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Border x:Name="FormatBadge" 
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="FormatBadgeText" 
                                   Text="{x:Bind ViewModel.HeaderFormatText, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="VariableBadge" 
                            Visibility="{x:Bind ViewModel.HeaderShowsVariableBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="Variable" FontSize="11"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="FontFileSize" 
                               Text="{x:Bind ViewModel.HeaderFileSize, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
           
            </Grid>

            <!-- ═══ Quick View ═══ -->
            <Border x:Name="QuickViewSection" Grid.Row="1" 
                    Visibility="{x:Bind ViewModel.IsQuickViewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Margin="20,10,20,4" Padding="16,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel x:Name="QuickViewPanel" Spacing="2" />
            </Border>

            <!-- ═══ Tab Bar (SelectorBar) ═══ -->
            <SelectorBar x:Name="TabSelectorBar" Grid.Row="2" Margin="12,0,12,4"
                         VerticalAlignment="Top"
                         SelectionChanged="TabSelectorBar_SelectionChanged">
                <SelectorBarItem x:Name="PreviewTab" Text="Preview" IsSelected="True" />
                <SelectorBarItem x:Name="GlyphsTab" Text="Glyphs" />
                <SelectorBarItem x:Name="InfoTab" Text="Info" />
            </SelectorBar>

            <!-- ═══ Content Panel ═══ -->
            <Frame x:Name="TabContentFrame" Grid.Row="2" Margin="0,38,0,0" NavigationFailed="TabContentFrame_NavigationFailed" />
        </Grid>
    </Grid>
</Page>
