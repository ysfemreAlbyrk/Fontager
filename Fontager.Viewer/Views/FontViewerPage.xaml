<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fontager.Viewer.Views.FontViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fontager.Viewer.Views"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converters="using:Fontager.Viewer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
        <converters:FontWeightToStringConverter x:Key="FontWeightToString" />
    </Page.Resources>

    <Grid x:Name="MainContentArea" Visibility="Visible">

        <!-- Empty State -->
        <Grid x:Name="EmptyState" Visibility="{x:Bind ViewModel.HasFont, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="20" HorizontalAlignment="Center" MaxWidth="420">
                <Image Source="ms-appx:///Assets/Logo.png" Width="64" Height="64" 
                       HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateTitle" Text="Fontager Viewer" 
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Open a font file to preview it, or drag and drop a .ttf, .otf, .ttc, or .woff2 file here."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="WrapWholeWords" />
                <Button Content="Open Font File" 
                        Click="OpenFileButton_Click"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="24,10" />
                <StackPanel Spacing="6" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyStateVersion" 
                               Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Made by Yusuf Emre Albayrak"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <HyperlinkButton x:Name="EmptyStateGitHub" Content="GitHub"
                                         Click="EmptyStateGitHub_Click"
                                         Padding="0" />
                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="EmptyStateWebsite" Content="Website"
                                         Click="EmptyStateWebsite_Click"
                                         Padding="0" />
                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="EmptyStateChangelog" Content="Changelog"
                                         Click="EmptyStateChangelog_Click"
                                         Padding="0" />
                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="EmptyStateRoadmap" Content="Roadmap"
                                         Click="EmptyStateRoadmap_Click"
                                         Padding="0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Loading State -->
        <Grid x:Name="LoadingState" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="Loading font..." 
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Error State -->
        <Grid x:Name="ErrorState" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="400">
                <FontIcon Glyph="&#xE783;" FontSize="48" 
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText" 
                           Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="WrapWholeWords" />
                <Button Content="Try Another File" 
                        Click="OpenFileButton_Click"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Font Content -->
        <Grid x:Name="FontContent" Visibility="{x:Bind ViewModel.HasFont, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══ Font Header ═══ -->
            <Grid Grid.Row="0" Padding="24,12,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top row: Name + nav + install -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FontFamilyName" Grid.Column="0"
                               Text="{x:Bind ViewModel.CurrentFont.DisplayName, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Right: nav + install -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                        <StackPanel x:Name="FontNavPanel" Orientation="Horizontal" Spacing="4" 
                                    Visibility="{x:Bind IsCollectionNavVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Button x:Name="PrevFontButton" Click="PrevFontButton_Click"
                                    ToolTipService.ToolTip="Previous font"
                                    IsEnabled="{x:Bind IsPrevFontEnabled, Mode=OneWay}" Padding="8,8"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE76B;" FontSize="11" />
                            </Button>
                            <TextBlock x:Name="FontIndexLabel" 
                                       Text="{x:Bind FontIndexLabelText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="2,0,2,2"/>
                            <Button x:Name="NextFontButton" Click="NextFontButton_Click"
                                    ToolTipService.ToolTip="Next font"
                                    IsEnabled="{x:Bind IsNextFontEnabled, Mode=OneWay}"
                                    Padding="8,8"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE76C;" FontSize="11" />
                            </Button>
                        </StackPanel>

                        <SplitButton x:Name="InstallSplitButton"
                                     Click="InstallSplitButton_Click"
                                     Padding="12,8"
                                     IsEnabled="{x:Bind IsInstallEnabled, Mode=OneWay}">
                            <SplitButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                                    <TextBlock x:Name="InstallButtonText"
                                               Text="Install"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="InstallCurrentUserMenuFlyoutItem"
                                                    Text="Install for current user"
                                                    Click="InstallCurrentUserMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="InstallAllUsersMenuFlyoutItem"
                                                    Text="Install for all users (requires admin)"
                                                    Click="InstallAllUsersMenuItem_Click" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <TextBlock x:Name="InstallNotSupportedMessage"
                                   Visibility="{x:Bind IsInstallNotSupportedVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   VerticalAlignment="Center"
                                   MaxWidth="280"
                                   TextWrapping="WrapWholeWords"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Installation isn&apos;t supported for WOFF2. Windows expects TrueType (.ttf), OpenType (.otf), or a collection (.ttc). Convert the file to install it." />
                    </StackPanel>
                </Grid>

                <!-- Bottom row: metadata chips -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <TextBlock x:Name="FontStyleName" 
                               Text="{x:Bind ViewModel.CurrentFont.Metadata.SubfamilyName, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Border x:Name="FormatBadge" 
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock x:Name="FormatBadgeText" 
                                   Text="{x:Bind ViewModel.CurrentFont.Format, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <Border x:Name="VariableBadge" 
                            Visibility="{x:Bind ViewModel.CurrentFont.Metadata.IsVariable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="Variable" FontSize="11"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </Border>
                    <TextBlock x:Name="FontFileSize" 
                               Text="{x:Bind ViewModel.CurrentFont.FormattedFileSize, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ═══ Quick View ═══ -->
            <Border x:Name="QuickViewSection" Grid.Row="1" 
                    Visibility="{x:Bind IsQuickViewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Margin="20,10,20,4" Padding="16,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel x:Name="QuickViewPanel" Spacing="2" />
            </Border>

            <!-- ═══ Tabs ═══ -->
            <Pivot x:Name="ContentPivot" Grid.Row="2" Margin="12,0,0,0"
                   SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}">
                <Pivot.Resources>
                    <Style TargetType="PivotHeaderItem">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Height" Value="32" />
                    </Style>
                </Pivot.Resources>
                <Pivot.ItemContainerTransitions>
                    <TransitionCollection>
                        <ContentThemeTransition />
                    </TransitionCollection>
                </Pivot.ItemContainerTransitions>

                <!-- Preview Tab -->
                <PivotItem Header="Preview">
                    <Border x:Name="PreviewSurfaceBorder" Background="Transparent">
                        <ScrollViewer Padding="-12,8,12,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">

                                <!-- Editable preview + size control -->
                                <Grid x:Name="PreviewSection" ColumnSpacing="12"
                                      Visibility="{x:Bind IsPreviewControlsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PreviewTextBox" Grid.Column="0"
                                             PlaceholderText="Type preview text here..."
                                             Text="{x:Bind ViewModel.PreviewText, Mode=TwoWay}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}"
                                             MinHeight="56"
                                             Padding="12"
                                             BorderThickness="0"
                                             CornerRadius="8" />

                                    <!-- Size control on the right -->
                                    <StackPanel Grid.Column="1" Spacing="2"
                                                VerticalAlignment="Center">
                                        <Button x:Name="FontSizeUpButton"
                                                Click="FontSizeUpButton_Click"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Padding="6,4" MinWidth="0" MinHeight="0"
                                                ToolTipService.ToolTip="Increase font size">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        </Button>
                                        <TextBlock x:Name="FontSizeLabel"
                                                   Text="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" 
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button x:Name="FontSizeDownButton"
                                                Click="FontSizeDownButton_Click"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Padding="6,4" MinWidth="0" MinHeight="0"
                                                ToolTipService.ToolTip="Decrease font size">
                                            <FontIcon Glyph="&#xE738;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Waterfall -->
                                <StackPanel x:Name="WaterfallSection" Spacing="0" Margin="0" Padding="0,0,0,0"
                                            Visibility="{x:Bind IsWaterfallVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel x:Name="WaterfallPanel" Spacing="0" Margin="0" Padding="0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </PivotItem>

                <!-- Glyphs Tab -->
                <PivotItem Header="Glyphs">
                    <Border Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar: search + category chips -->
                            <Grid Grid.Row="0" Padding="12,8,12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <AutoSuggestBox x:Name="GlyphSearchBox" Grid.Column="0"
                                                PlaceholderText="Search character or code point (e.g. A, U+00A0, 9731)"
                                                QueryIcon="Find"
                                                Text="{x:Bind ViewModel.GlyphSearchText, Mode=TwoWay}" />

                                <StackPanel x:Name="GlyphCategoryChips" Grid.Column="1"
                                            Orientation="Horizontal" Spacing="4" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Sidebar: Unicode blocks covered by the font -->
                                <ListView x:Name="GlyphBlockList" Grid.Column="0"
                                          Margin="6,0,6,8"
                                          SelectionMode="Single"
                                          ItemsSource="{x:Bind ViewModel.GlyphBlockEntries, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedBlockEntry, Mode=TwoWay}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="MinHeight" Value="34" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Glyph grid + details -->
                                <Grid Grid.Column="1" Padding="12,0,12,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Margin="0,0,0,8"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind ViewModel.FilteredGlyphs.Count, Mode=OneWay}" />
                                        <Run Text=" glyphs shown" />
                                    </TextBlock>

                                    <GridView Grid.Row="1" x:Name="GlyphGrid"
                                              SelectionMode="Single"
                                              ItemsSource="{x:Bind ViewModel.FilteredGlyphs, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedGlyph, Mode=TwoWay}"
                                              IsItemClickEnabled="True"
                                              ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollMode="Enabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.IsVerticalScrollChainingEnabled="False">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal"
                                                               ItemWidth="72" ItemHeight="88"
                                                               CacheLength="2" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="72" Height="88" Padding="2"
                                                      Background="Transparent">
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding Character}"
                                                                   FontSize="28"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding UnicodeLabel}"
                                                                   FontSize="10"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                    <Border Grid.Row="2" x:Name="GlyphDetailPanel" Visibility="{x:Bind ViewModel.GetGlyphDetailVisibility(ViewModel.IsGlyphSelected), Mode=OneWay}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="24" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-8,-8,-8"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="Close"
                                                    AutomationProperties.Name="Close glyph details"
                                                    Click="GlyphDetailClose_Click">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                            </Button>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SelectedGlyphChar"
                                                           Grid.Column="0"
                                                           FontSize="72"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,24,0"
                                                           Text="{x:Bind ViewModel.SelectedGlyph.Character, Mode=OneWay}"
                                                           FontFamily="{x:Bind LoadedFontFamily, Mode=OneWay}"
                                                           FontWeight="Normal" FontStyle="Normal" />
                                                <StackPanel Grid.Column="1"
                                                            Spacing="10"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,16,0">
                                                    <TextBlock x:Name="SelectedGlyphUnicode"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               Text="{x:Bind ViewModel.SelectedGlyph.UnicodeLabel, Mode=OneWay}" />
                                                    <TextBlock x:Name="SelectedGlyphName"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="WrapWholeWords"
                                                               Text="{x:Bind ViewModel.SelectedGlyph.DetailsLabel, Mode=OneWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            Spacing="6">
                                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                                            HorizontalAlignment="Right"
                                                            Click="GlyphDetailCopy_Click"
                                                            ToolTipService.ToolTip="Copy character to clipboard">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                            <TextBlock Text="Copy character"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock x:Name="GlyphDetailCopiedNotice"
                                                               Text="Copied"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                               HorizontalAlignment="Right"
                                                               Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </PivotItem>

                <!-- Metadata Tab -->
                <PivotItem Header="Info">
                    <Border Background="Transparent">
                        <ScrollViewer Padding="12,8" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4" x:Name="MetadataPanel" />
                        </ScrollViewer>
                    </Border>
                </PivotItem>

            </Pivot>
        </Grid>
    </Grid>
</Page>
