<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fontager.Viewer.Views.GlyphsTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fontager.Viewer.Views"
    xmlns:converters="using:Fontager.Viewer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: search + category chips -->
        <Grid Grid.Row="0" Padding="8,8,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="GlyphSearchBox" Grid.Column="0"
                            PlaceholderText="Search character or code point (e.g. A, U+00A0, 9731)"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.GlyphSearchText, Mode=TwoWay}" />

            <StackPanel x:Name="GlyphCategoryChips" Grid.Column="1"
                        Orientation="Horizontal" Spacing="4" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="148" MaxWidth="188" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Unicode blocks covered by the font -->
            <ListView x:Name="GlyphBlockList" Grid.Column="0"
                      Margin="4,0,4,8"
                      SelectionMode="Single"
                      ItemsSource="{x:Bind ViewModel.GlyphBlockEntries, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedBlockEntry, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="MinHeight" Value="30" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Count}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Glyph grid + details -->
            <Grid Grid.Column="1" Padding="4,0,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="0,0,0,8"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind ViewModel.FilteredGlyphs.Count, Mode=OneWay}" />
                    <Run Text=" glyphs shown" />
                </TextBlock>

                <GridView Grid.Row="1" x:Name="GlyphGrid"
                          SelectionMode="Single"
                          ItemsSource="{x:Bind ViewModel.FilteredGlyphs, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedGlyph, Mode=TwoWay}"
                          IsItemClickEnabled="True"
                          FontFamily="{x:Bind ViewModel.LoadedFontFamily, Mode=OneWay}"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.IsVerticalScrollChainingEnabled="False">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="72" ItemHeight="88"
                                           CacheLength="2" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="72" Height="88" Padding="2"
                                  Background="Transparent">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="{Binding Character}"
                                               FontSize="28"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UnicodeLabel}"
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Border Grid.Row="2" x:Name="GlyphDetailPanel" Visibility="{x:Bind ViewModel.GetGlyphDetailVisibility(ViewModel.IsGlyphSelected), Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="24" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-8,-8,-8"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Close"
                                AutomationProperties.Name="Close glyph details"
                                Click="GlyphDetailClose_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedGlyphChar"
                                       Grid.Column="0"
                                       FontSize="72"
                                       VerticalAlignment="Center"
                                       Margin="0,0,24,0"
                                       Text="{x:Bind ViewModel.SelectedGlyphCharacter, Mode=OneWay}"
                                       FontWeight="Normal" FontStyle="Normal" />
                            <StackPanel Grid.Column="1"
                                        Spacing="10"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0">
                                <TextBlock x:Name="SelectedGlyphUnicode"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SelectedGlyphUnicodeLabel, Mode=OneWay}" />
                                <TextBlock x:Name="SelectedGlyphName"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"
                                           Text="{x:Bind ViewModel.SelectedGlyphDetailsLabel, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Spacing="6">
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Click="GlyphDetailCopy_Click"
                                        ToolTipService.ToolTip="Copy character to clipboard">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock Text="Copy character"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="GlyphDetailCopiedNotice"
                                           Text="Copied"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           HorizontalAlignment="Right"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
