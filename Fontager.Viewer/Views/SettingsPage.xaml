<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fontager.Viewer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!--
        Windows 11 inbox-app pattern (Notepad / Snipping Tool): ~2:1 horizontal split,
        settings cards fill the LEFT column (star-sized), About sits in the RIGHT column.
        Each setting is a rounded card: glyph + title/description + control on the right.
    -->

    <Page.Resources>
        <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="56,16,56,8" />

        <!-- Two-pane body: left column grows with window (Star), right ~half width (Star) — matches inbox apps -->
        <ScrollViewer Grid.Row="1"
                      Padding="0,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="TwoPaneRoot"
                  Padding="56,0,56,40"
                  SizeChanged="TwoPaneRoot_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsColumnDef"
                                      Width="2*"
                                      MinWidth="280" />
                    <ColumnDefinition x:Name="GapColumnDef" Width="32" />
                    <ColumnDefinition x:Name="AboutColumnDef"
                                      Width="*"
                                      MinWidth="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- LEFT: settings fill full width of this column (anchored to window left via padding) -->
                <StackPanel x:Name="SettingsSectionsPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Spacing="0">

                    <TextBlock Text="Appearance"
                               Style="{StaticResource SettingsSectionHeaderStyle}"
                               Margin="0,0,0,10" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE771;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Theme"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Use light, dark, or match Windows."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      MinWidth="200"
                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="System default" Tag="0" />
                                <ComboBoxItem Content="Light" Tag="1" />
                                <ComboBoxItem Content="Dark" Tag="2" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE81E;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Backdrop material"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Window backdrop: Mica, Mica Alt, Acrylic, or Solid theme fill."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox x:Name="BackdropCombo"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      MinWidth="200"
                                      SelectionChanged="BackdropCombo_SelectionChanged">
                                <ComboBoxItem Content="Mica" Tag="0" />
                                <ComboBoxItem Content="Mica Alt" Tag="3" />
                                <ComboBoxItem Content="Acrylic" Tag="1" />
                                <ComboBoxItem Content="Solid" Tag="2" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="Preview"
                               Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE8D2;"
                                          FontSize="20"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Default preview text"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Shown in the preview area and waterfall when you open a font."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="PreviewTextBox"
                                     Grid.Row="1"
                                     PlaceholderText="Enter default preview text..."
                                     TextWrapping="Wrap"
                                     AcceptsReturn="False"
                                     MaxLength="500"
                                     TextChanged="PreviewTextBox_TextChanged"
                                     LostFocus="PreviewTextBox_LostFocus" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE8E9;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock x:Name="FontSizeSliderHeaderText"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="Default font size" />
                                <TextBlock Text="Default point size for the editable preview box."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Slider x:Name="FontSizeSlider"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Width="220"
                                    Minimum="8"
                                    Maximum="120"
                                    StepFrequency="1"
                                    ValueChanged="FontSizeSlider_ValueChanged" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE70F;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Editable preview"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Show the text preview area with size controls. When off, only the waterfall is shown."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="PreviewControlsToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="PreviewControlsToggle_Toggled" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Display"
                               Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE8FF;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Quick view"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Character overview under the font header. Automatically appears in small windows."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="QuickViewToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="QuickViewToggle_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE81E;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Waterfall"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Show multiple sample sizes at once."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WaterfallToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="WaterfallToggle_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE149;"
                                          FontSize="20"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Waterfall sizes"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Comma-separated pixel sizes (e.g. 8, 12, 16, 24)."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="WaterfallSizesBox"
                                     Grid.Row="1"
                                     PlaceholderText="8,12,16,24,32,48,72"
                                     AcceptsReturn="False"
                                     MaxLength="200"
                                     LostFocus="WaterfallSizesBox_LostFocus" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Install"
                               Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE7B8;"
                                          FontSize="20"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="4"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="Install target"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="InstallTargetDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ComboBox x:Name="InstallModeCombo"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          MinWidth="220"
                                          SelectionChanged="InstallModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Current user" Tag="0" />
                                    <ComboBoxItem Content="All users (Windows\Fonts)" Tag="1" />
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE72E;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="UAC for all-users install"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ElevateForAllUsersInstallDescription"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ElevateForAllUsersInstallToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="ElevateForAllUsersInstallToggle_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE756;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Run entire app as administrator"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="RunAsAdminDescription"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RunAsAdminToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="RunAsAdminToggle_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE823;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Exit after successful install"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="When on, the success message appears for one second, then Fontager closes. When off, tap OK to continue."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ExitAfterInstallToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="ExitAfterInstallToggle_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE71B;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Register for font files"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="FontAssocDescription"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="FontAssocToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="FontAssocToggle_Toggled" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Reset"
                               Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Restore defaults"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Clear saved preferences and return to built-in defaults."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords" />
                            <Button Content="Reset all settings to defaults"
                                    Click="ResetButton_Click"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT: About column (top-aligned with first settings section inside scroll) -->
                <Border x:Name="AboutCard"
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,18">
                    <StackPanel Spacing="14">
                    <!-- <TextBlock Text="About this app"
                                   Style="{StaticResource SubtitleTextBlockStyle}" /> -->
 
                        <!-- <Border Height="1"
                                Margin="0,6,0,6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border> -->
                   
                        <StackPanel Orientation="Vertical" Spacing="14">
                                <Image x:Name="AboutLogoImage"
                                       Width="44"
                                       Height="44"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Fontager Viewer"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="AboutVersionText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <!-- <TextBlock x:Name="AboutBuildKindText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" /> -->
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords"
                                   LineHeight="20"
                                   Text="A modern, powerful font viewer application for Windows, built with WinUI 3" />

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords"
                                   Text="MIT License · Made by Yusuf Emre Albayrak ©2026" />

                        <StackPanel Spacing="4">
                            <HyperlinkButton Content="Official Website"
                                             NavigateUri="https://ysfemrealbyrk.github.io/Fontager/"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                            <HyperlinkButton Content="Repository on GitHub (ysfemreAlbyrk/Fontager)"
                                             NavigateUri="https://github.com/ysfemreAlbyrk/Fontager"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                            <HyperlinkButton Content="Report an issue"
                                             NavigateUri="https://github.com/ysfemreAlbyrk/Fontager/issues"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                            <HyperlinkButton Content="Changelog"
                                             NavigateUri="https://github.com/ysfemreAlbyrk/Fontager/blob/main/CHANGELOG.md"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                            <HyperlinkButton Content="Releases &amp; downloads"
                                             NavigateUri="https://github.com/ysfemreAlbyrk/Fontager/releases"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
