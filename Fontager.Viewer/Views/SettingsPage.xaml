<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fontager.Viewer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Fontager.Viewer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!--
        Windows 11 inbox-app pattern (Notepad / Snipping Tool): ~2:1 horizontal split,
        settings cards fill the LEFT column (star-sized), About sits in the RIGHT column.
        Each setting is a rounded card: glyph + title/description + control on the right.
    -->

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />

        <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
        <!-- Tighter than default Expander (16,0,0,0 header + 20,0,8,0 chevron margin + 16 content). -->
        <Thickness x:Key="ExpanderHeaderPadding">0,0,0,0</Thickness>
        <Thickness x:Key="ExpanderChevronMargin">4,0,8,0</Thickness>
        <Thickness x:Key="ExpanderContentPadding">0,0,0,0</Thickness>
        <Style x:Key="SettingsGroupExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SettingsExpanderHeaderGridStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0,14,0,14" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
        <Style x:Key="SettingsExpanderNestedRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <!-- Indented under header title (icon + spacing), with horizontal padding on both sides. -->
            <Setter Property="Padding" Value="56,12,16,12" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="56,16,56,8" />

        <!-- Two-pane body: left column grows with window (Star), right ~half width (Star) — matches inbox apps -->
        <ScrollViewer Grid.Row="1"
                      Padding="0,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="TwoPaneRoot"
                  Padding="56,0,56,40"
                  SizeChanged="TwoPaneRoot_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsColumnDef"
                                      Width="2*"
                                      MinWidth="280" />
                    <ColumnDefinition x:Name="GapColumnDef" Width="32" />
                    <ColumnDefinition x:Name="AboutColumnDef"
                                      Width="*"
                                      MinWidth="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- LEFT: settings fill full width of this column (anchored to window left via padding) -->
                <StackPanel x:Name="SettingsSectionsPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Spacing="0">

                    <TextBlock Text="Appearance"
                               Style="{StaticResource SettingsSectionHeaderStyle}"
                               Margin="0,0,0,10" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE771;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Theme"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Use light, dark, or match Windows."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      MinWidth="200"
                                      SelectedIndex="{x:Bind ViewModel.ThemeComboIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="System default" Tag="0" />
                                <ComboBoxItem Content="Light" Tag="1" />
                                <ComboBoxItem Content="Dark" Tag="2" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE81E;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Backdrop material"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Window backdrop: Mica, Mica Alt, Acrylic, or Solid theme fill."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox x:Name="BackdropCombo"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      MinWidth="200"
                                      SelectedIndex="{x:Bind ViewModel.BackdropComboIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Mica" Tag="0" />
                                <ComboBoxItem Content="Mica Alt" Tag="3" />
                                <ComboBoxItem Content="Acrylic" Tag="1" />
                                <ComboBoxItem Content="Solid" Tag="2" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="Preview"
                               Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <!-- 2 settings cards -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE8D2;"
                                          FontSize="20"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Default preview text"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Shown in the preview area and waterfall when you open a font."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="PreviewTextBox"
                                     Grid.Row="1"
                                     PlaceholderText="Enter default preview text..."
                                     TextWrapping="Wrap"
                                     AcceptsReturn="False"
                                     MaxLength="500"
                                     Text="{x:Bind ViewModel.DefaultPreviewText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE790;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                            <TextBlock Text="Default preview background"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="Contrast for the editable preview and Quick View panels."
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox x:Name="PreviewBgCombo"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      MinWidth="200"
                                      SelectedIndex="{x:Bind ViewModel.PreviewBackground, Mode=TwoWay}">
                                <ComboBoxItem Content="System default" Tag="0" />
                                <ComboBoxItem Content="Light background" Tag="1" />
                                <ComboBoxItem Content="Dark background" Tag="2" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Quick View -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}" Padding="0">
                        <Expander x:Name="QuickViewExpander"
                                  Style="{StaticResource SettingsGroupExpanderStyle}"
                                  IsExpanded="False">
                            <Expander.Header>
                                <Grid Style="{StaticResource SettingsExpanderHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE8FF;"
                                              FontSize="20"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="4"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Quick View"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Character overview under the font header. Automatically appears in small windows."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="QuickViewToggle"
                                                  Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  OnContent=""
                                                  OffContent=""
                                                  IsOn="{x:Bind ViewModel.ShowQuickView, Mode=TwoWay}" />
                                </Grid>
                            </Expander.Header>
                            <ContentControl IsEnabled="{x:Bind ViewModel.ShowQuickView, Mode=OneWay}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Top">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsExpanderNestedRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Spacing="4"
                                                        Margin="0,0,12,0">
                                                <TextBlock x:Name="QuickViewFontSizeSliderHeaderText"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           Text="{x:Bind ViewModel.QuickViewFontSizeLabel, Mode=OneWay}" />
                                                <TextBlock Text="Font size for the characters in the Quick view overview panel."
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <Slider x:Name="QuickViewFontSizeSlider"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Width="220"
                                                    Minimum="12"
                                                    Maximum="48"
                                                    StepFrequency="1"
                                                    Value="{x:Bind ViewModel.QuickViewFontSize, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ContentControl>
                        </Expander>
                    </Border>

                    <!-- Editable Preview -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}" Padding="0">
                        <Expander x:Name="EditablePreviewExpander"
                                  Style="{StaticResource SettingsGroupExpanderStyle}"
                                  IsExpanded="False">
                            <Expander.Header>
                                <Grid Style="{StaticResource SettingsExpanderHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE70F;"
                                              FontSize="20"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="4"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Editable Preview"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Show the text preview area with size controls. When off, only the waterfall is shown."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PreviewControlsToggle"
                                                  Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  OnContent=""
                                                  OffContent=""
                                                  IsOn="{x:Bind ViewModel.ShowPreviewControls, Mode=TwoWay}" />
                                </Grid>
                            </Expander.Header>
                            <ContentControl IsEnabled="{x:Bind ViewModel.ShowPreviewControls, Mode=OneWay}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Top">
                                <Border Style="{StaticResource SettingsExpanderNestedRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Spacing="4"
                                                    Margin="0,0,12,0">
                                            <TextBlock x:Name="FontSizeSliderHeaderText"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Text="{x:Bind ViewModel.DefaultFontSizeLabel, Mode=OneWay}" />
                                            <TextBlock Text="Default point size for the editable preview box."
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <Slider x:Name="FontSizeSlider"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Width="220"
                                                Minimum="8"
                                                Maximum="120"
                                                StepFrequency="1"
                                                Value="{x:Bind ViewModel.DefaultFontSize, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </ContentControl>
                        </Expander>
                    </Border>

                    <!-- Waterfall -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}" Padding="0">
                        <Expander x:Name="WaterfallExpander"
                                  Style="{StaticResource SettingsGroupExpanderStyle}"
                                  IsExpanded="False">
                            <Expander.Header>
                                <Grid Style="{StaticResource SettingsExpanderHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE81E;"
                                              FontSize="20"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="4"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Waterfall"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Show multiple sample sizes at once."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="WaterfallToggle"
                                                  Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  OnContent=""
                                                  OffContent=""
                                                  IsOn="{x:Bind ViewModel.ShowWaterfall, Mode=TwoWay}" />
                                </Grid>
                            </Expander.Header>
                            <ContentControl IsEnabled="{x:Bind ViewModel.ShowWaterfall, Mode=OneWay}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Top">
                            <Border Style="{StaticResource SettingsExpanderNestedRowStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Waterfall sizes"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Comma-separated pixel sizes (e.g. 8, 12, 16, 24)."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <TextBox x:Name="WaterfallSizesBox"
                                             PlaceholderText="8,12,16,24,32,48,72"
                                             AcceptsReturn="False"
                                             MaxLength="200"
                                             Text="{x:Bind ViewModel.WaterfallSizesRaw, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                            </ContentControl>
                        </Expander>
                    </Border>

                    <TextBlock Text="Install"
                               Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE7B8;"
                                          FontSize="20"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="4"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="Install target"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="InstallTargetDescription"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ComboBox x:Name="InstallModeCombo"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          MinWidth="220"
                                          SelectedIndex="{x:Bind ViewModel.InstallMode, Mode=TwoWay}">
                                    <ComboBoxItem Content="Current user" Tag="0" />
                                    <ComboBoxItem Content="All users (Windows\Fonts)" Tag="1" IsEnabled="{x:Bind ViewModel.CanSelectAllUsersInstallTarget, Mode=OneWay}" />
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE72E;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="UAC for all-users install"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ElevateForAllUsersInstallDescription"
                                           Text="{x:Bind ViewModel.ElevateForAllUsersInstallDescription, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ElevateForAllUsersInstallToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{x:Bind ViewModel.ElevateForAllUsersInstall, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE756;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Run entire app as administrator"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="RunAsAdminDescription"
                                           Text="{x:Bind ViewModel.RunAsAdminDescription, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RunAsAdminToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{x:Bind ViewModel.RunAsAdministrator, Mode=OneWay}"
                                          Toggled="RunAsAdminToggle_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE823;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Exit after successful install"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="When on, the success message appears for one second, then Fontager closes. When off, tap OK to continue."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ExitAfterInstallToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{x:Bind ViewModel.ExitAppAfterSuccessfulInstall, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE71B;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Register for font files"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="FontAssocDescription"
                                           Text="{x:Bind ViewModel.FileAssociationDescriptionText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="FontAssocToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{x:Bind ViewModel.FontAssociationRegistered, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.IsFileAssociationSupported, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Updates"
                               Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE895;"
                                      FontSize="20"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Check for updates automatically"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Automatically check for new versions and notify you in the title bar."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch x:Name="UpdateCheckToggle"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{x:Bind ViewModel.IsUpdateNotificationEnabled, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <!-- 1. State: Update Available (Visible only when update is available) -->
                            <Grid x:Name="UpdateAvailablePanel" ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Button x:Name="UpdateAvailableButton" 
                                        Style="{StaticResource SubtleButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="UpdateAvailableButton_Click"
                                        Padding="4,4,12,4">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Gradient circle with refresh icon -->
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                                                    <GradientStop Offset="0.0" Color="#239DE0" />
                                                    <GradientStop Offset="1.0" Color="#037CD6" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="11" Foreground="White" Glyph="&#xE895;" />
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="Update Available" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                                                <Run Text="Version" />
                                                <Run x:Name="UpdateAvailableVersionText" Text="{x:Bind ViewModel.LatestAvailableVersion, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                
                                <!-- Right side download button -->
                                <Button x:Name="DownloadButton" 
                                        Grid.Column="1" 
                                        Content="Download" 
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="UpdateAvailableButton_Click" />
                            </Grid>

                            <!-- 2. State: Up to date (Visible only when NO update is available) -->
                            <Grid x:Name="UpdateNotAvailablePanel" ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Grid Padding="0,0,4,0" VerticalAlignment="Center" ColumnSpacing="16" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Gradient circle with check icon -->
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                                                <GradientStop Offset="0.0" Color="#6FB538" />
                                                <GradientStop Offset="1.0" Color="#397A24" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="11" Foreground="White" Glyph="&#xE73E;" />
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="You're up to date" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                                            <Run Text="Last checked:" />
                                            <Run x:Name="LastUpdateCheckDateText" Text="{x:Bind ViewModel.LastUpdateCheckText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <ProgressRing x:Name="UpdateProgressRing"
                                                  IsActive="False"
                                                  Visibility="Collapsed"
                                                  Width="20" Height="20" />
                                    <Button x:Name="ManualCheckButton"
                                            Content="Check now"
                                            Click="ManualCheckButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>


                    <TextBlock Text="Reset"
                               Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Restore defaults"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Clear saved preferences and return to built-in defaults."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords" />
                            <Button Content="Reset all settings to defaults"
                                    Click="ResetButton_Click"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT: About column (top-aligned with first settings section inside scroll) -->
                <Border x:Name="AboutCard"
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,18">
                    <StackPanel Spacing="14">
                   
                        <StackPanel Orientation="Vertical" Spacing="14">
                                <Image x:Name="AboutLogoImage"
                                       Width="44"
                                       Height="44"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Fontager Viewer"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="AboutVersionText"
                                           Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords"
                                   LineHeight="20"
                                   Text="A modern, powerful font viewer application for Windows, built with WinUI 3" />

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords"
                                   Text="MIT License · Made by Yusuf Emre Albayrak ©2026" />

                        <StackPanel Spacing="4">
                            <HyperlinkButton Content="Official Website"
                                             NavigateUri="https://ysfemrealbyrk.github.io/Fontager/"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                            <HyperlinkButton Content="Repository on GitHub (ysfemreAlbyrk/Fontager)"
                                             NavigateUri="https://github.com/ysfemreAlbyrk/Fontager"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                            <HyperlinkButton Content="Report an issue"
                                             NavigateUri="https://github.com/ysfemreAlbyrk/Fontager/issues"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                            <HyperlinkButton Content="Changelog"
                                             NavigateUri="https://github.com/ysfemreAlbyrk/Fontager/blob/main/CHANGELOG.md"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                            <HyperlinkButton Content="Releases &amp; downloads"
                                             NavigateUri="https://github.com/ysfemreAlbyrk/Fontager/releases"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
