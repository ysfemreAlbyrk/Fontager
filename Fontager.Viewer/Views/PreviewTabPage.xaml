<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fontager.Viewer.Views.PreviewTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fontager.Viewer.Views"
    xmlns:converters="using:Fontager.Viewer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Border x:Name="PreviewSurfaceBorder" Background="Transparent" Visibility="Visible">
        <ScrollViewer Padding="0,8,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- Editable preview + size control -->
                <Grid x:Name="PreviewSection" ColumnSpacing="12" Padding="12,0,0,0"
                      Visibility="{x:Bind ViewModel.IsPreviewControlsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PreviewTextBox" Grid.Column="0"
                             PlaceholderText="Type preview text here..."
                             Text="{x:Bind ViewModel.PreviewText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}"
                             MinHeight="56"
                             Padding="12"
                             BorderThickness="0"
                             CornerRadius="8" />

                    <!-- Size control on the right -->
                    <StackPanel Grid.Column="1" Spacing="2"
                                VerticalAlignment="Center">
                        <Button x:Name="FontSizeUpButton"
                                Click="FontSizeUpButton_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="6,4" MinWidth="0" MinHeight="0"
                                ToolTipService.ToolTip="Increase font size">
                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                        </Button>
                        <TextBlock x:Name="FontSizeLabel"
                                   Text="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" 
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="FontSizeDownButton"
                                Click="FontSizeDownButton_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="6,4" MinWidth="0" MinHeight="0"
                                ToolTipService.ToolTip="Decrease font size">
                            <FontIcon Glyph="&#xE738;" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Waterfall -->
                <StackPanel x:Name="WaterfallSection" Spacing="0" Margin="0" Padding="4,0,0,0"
                            Visibility="{x:Bind ViewModel.IsWaterfallVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel x:Name="WaterfallPanel" Spacing="0" Margin="0" Padding="0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
